<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.metadatacenter</groupId>
    <artifactId>cedar-user-server</artifactId>
    <version>2.9.31-SNAPSHOT</version>
  </parent>

  <groupId>org.metadatacenter</groupId>
  <artifactId>cedar-user-server-application</artifactId>
  <packaging>jar</packaging>

  <name>CEDAR User Server Dropwizard Application</name>

  <properties>
    <!-- Opt in to the cedar-shade execution managed in cedar-parent. -->
    <cedar.shade.phase>package</cedar.shade.phase>
    <cedar.shade.main.class>org.metadatacenter.cedar.user.UserServerApplication</cedar.shade.main.class>
    <!-- Line coverage measured on 2026-10-19: 83.0% in CI and 86.7% locally. The floor follows
         the lower figure, and the build fails below it. -->
    <cedar.coverage.line.minimum>0.81</cedar.coverage.line.minimum>
    <!-- Branch coverage measured on 2026-10-26: 76.3%. The build fails below this floor. -->
    <cedar.coverage.branch.minimum>0.74</cedar.coverage.branch.minimum>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-rest-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-config-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-globals-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-utils-dropwizard-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-user-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>

    <!-- OpenAPI annotations used to generate the committed User Server specification. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-testing</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- In-process Neo4j and graph seeding for integration tests -->
    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-test-support-library</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      JNA reaches the test classpath through the embedded Neo4j in cedar-test-support-library, at
      the version cedar-parent manages. This module declares it at test scope to match the
      resource, group and worker servers, where the same declaration also keeps the JNA that the
      OpenSearch server jar brings off the runtime classpath.
    -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>

    <plugins>

      <!--
        The tests redirect the CEDAR environment variables (embedded Neo4j, alternate server
        ports) through a CedarEnvironmentSource override instead of reflective environment
        rewriting, so no add-opens flags are needed and the test classes share a JVM
        (reuseForks true): CedarConfig.getInstance rebuilds whenever the override changes.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <reuseForks>true</reuseForks>
        </configuration>
      </plugin>

      <!-- Filter the base document so the generated specification carries the Maven version. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>filter-openapi-base</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-swagger</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/swagger</directory>
                  <includes>
                    <include>openapi-base.yaml</include>
                  </includes>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Generates the OpenAPI 3.0 spec from the JAX-RS (jakarta.ws.rs) resource annotations. The
        phase, output locations and format come from cedar-parent; this module names only the
        package to scan. Info and the api_key security scheme come from the filtered
        openapi-base.yaml.
      -->
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin-jakarta</artifactId>
        <configuration>
          <resourcePackages>
            <package>org.metadatacenter.cedar.user.resources</package>
            <package>org.metadatacenter.cedar.util.dw</package>
          </resourcePackages>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>

    </plugins>

  </build>

</project>
