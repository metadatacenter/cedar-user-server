{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "CEDAR user profile and API-key management.\n\nThe profile update endpoint accepts a field-level UI-preferences patch despite its historical\nPUT method. The server locks and rereads the stored profile, applies only the requested settings,\nand writes only UI preferences. API-key creation, rotation, and deletion are likewise atomic\ncommands over the current stored key list. These operations do not replace a caller-held user\nrepresentation, so they do not use ETag or If-Match preconditions.\n",
    "title" : "CEDAR User Server API",
    "version" : "2.9.9-SNAPSHOT"
  },
  "paths" : {
    "/users/{id}" : {
      "get" : {
        "description" : "Returns the authenticated user's complete CEDAR profile. A user cannot read another user's profile.",
        "operationId" : "findOwnUser",
        "parameters" : [ {
          "description" : "CEDAR user UUID",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarUser"
                }
              }
            },
            "description" : "The current user's profile"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Unauthorized"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Another user's profile was requested"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Get the current user's profile",
        "tags" : [ "Users" ]
      },
      "put" : {
        "description" : "Applies the supplied dotted-path preference changes to the current stored profile under a Neo4j write lock. Only uiPreferences fields are accepted, and the write cannot overwrite API keys, roles, permissions, identity fields, or the home folder. Because this is a field-level atomic patch rather than representation replacement, it does not use If-Match.",
        "operationId" : "updateUser",
        "parameters" : [ {
          "description" : "CEDAR user UUID",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "*/*" : {
              "schema" : {
                "type" : "object",
                "example" : {
                  "uiPreferences.stylesheet" : "cedar-dark",
                  "uiPreferences.preferredDateFormat" : "YYYY-MM-DD"
                }
              }
            }
          },
          "description" : "An object whose keys are dotted uiPreferences paths",
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarUser"
                }
              }
            },
            "description" : "The updated user profile"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "A modification is invalid or targets a non-preference field"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Unauthorized"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Another user's profile was targeted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "User not found"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Patch the current user's UI preferences",
        "tags" : [ "Users" ]
      }
    },
    "/users/{id}/api-keys" : {
      "post" : {
        "description" : "Atomically appends a newly generated credential to the current stored key list. Concurrent creations are serialized and all successful keys survive. Self-only; a user may hold at most 20 keys. This command does not use If-Match.",
        "operationId" : "createApiKey",
        "parameters" : [ {
          "description" : "CEDAR user UUID",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "*/*" : {
              "schema" : {
                "type" : "object",
                "example" : {
                  "description" : "analysis pipeline"
                }
              }
            }
          },
          "description" : "Optional API-key description"
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarUser"
                }
              }
            },
            "description" : "Created. Location names the new key; the body is the updated user profile, which is the only place the new key's value is readable"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The user already has the maximum number of keys"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Unauthorized"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Another user's keys were targeted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "User not found"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Create an API key",
        "tags" : [ "Users" ]
      }
    },
    "/users/{id}/api-keys/{keyId}" : {
      "delete" : {
        "description" : "Atomically removes one key from the current stored key list. Deleting the last enabled key is refused so the account retains a working credential. Self-only. This command does not use If-Match.",
        "operationId" : "deleteApiKey",
        "parameters" : [ {
          "description" : "CEDAR user UUID",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Stable, non-secret API-key management identifier",
          "in" : "path",
          "name" : "keyId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarUser"
                }
              }
            },
            "description" : "The updated user profile"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Deleting the key would leave no enabled credential"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Unauthorized"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Another user's keys were targeted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "User or key not found"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Delete an API key",
        "tags" : [ "Users" ]
      }
    },
    "/users/{id}/api-keys/{keyId}/regenerate" : {
      "post" : {
        "description" : "Atomically replaces one key's secret and creation time while preserving its stable management identifier and metadata. The previous secret is immediately revoked. Self-only. This command does not use If-Match.",
        "operationId" : "regenerateApiKey",
        "parameters" : [ {
          "description" : "CEDAR user UUID",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Stable, non-secret API-key management identifier",
          "in" : "path",
          "name" : "keyId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarUser"
                }
              }
            },
            "description" : "The updated user profile, including the rotated key"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Unauthorized"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Another user's keys were targeted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "User or key not found"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Internal server error"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Regenerate an API key",
        "tags" : [ "Users" ]
      }
    },
    "/users/{id}/summary" : {
      "get" : {
        "description" : "Returns display and federated-identity information. Self access and authorized administrator access only.",
